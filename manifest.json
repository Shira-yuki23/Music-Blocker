{
  "manifest_version": 3,
  "name": "YT Song Blocker",
  "version": "1.0.4",
  "description": "Hides song and music-related videos on YouTube based on their titles.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YT Song Blocker",
    "default_popup": "popup.html"
  }
}
